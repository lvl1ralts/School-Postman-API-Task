					"raw": "{{base_url}}/listSchools?latitude=23.1047&longitude=72.5920",
					"host": ["{{base_url}}"],
					"path": ["listSchools"],
					"query": [
						{
							"key": "latitude",
							"value": "23.1047"
						},
						{
							"key": "longitude",
							"value": "72.5920"
						}
					]
				}
			},
			"response": [
				{
					"name": "Success - Schools Listed by Proximity",
					"status": "OK",
					"code": 200,
					"body": "{\n  \"success\": true,\n  \"message\": \"Found 2 school(s).\",\n  \"data\": [\n    {\n      \"id\": 2,\n      \"name\": \"Puna International School\",\n      \"address\": \"Chandkheda, Ahmedabad, Gujarat\",\n      \"latitude\": 23.1015,\n      \"longitude\": 72.5893,\n      \"distance_km\": 0.46\n    },\n    {\n      \"id\": 1,\n      \"name\": \"Podar International School\",\n      \"address\": \"Chandkheda, Ahmedabad, Gujarat\",\n      \"latitude\": 23.1081,\n      \"longitude\": 72.5971,\n      \"distance_km\": 0.62\n    }\n  ]\n}"
				},
				{
