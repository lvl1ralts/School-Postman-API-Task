					"path": [""]
				}
			},
			"response": [
				{
					"name": "Success",
					"status": "OK",
					"code": 200,
					"body": "{\n  \"success\": true,\n  \"message\": \"School Management API is running.\",\n  \"endpoints\": {\n    \"addSchool\": \"POST /addSchool\",\n    \"listSchools\": \"GET /listSchools?latitude=<lat>&longitude=<lon>\"\n  }\n}"
				}
			]
		},
		{
			"name": "Add School - Podar International",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Podar International School\",\n  \"address\": \"Chandkheda, Ahmedabad, Gujarat\",\n  \"latitude\": 23.1081,\n  \"longitude\": 72.5971\n}"
				},
				"url": {
					"raw": "{{base_url}}/addSchool",
					"host": ["{{base_url}}"],
					"path": ["addSchool"]
				}
			},
			"response": [
				{
					"name": "Success - School Added",
					"status": "Created",
					"code": 201,
					"body": "{\n  \"success\": true,\n  \"message\": \"School added successfully.\",\n  \"data\": {\n    \"id\": 1,\n    \"name\": \"Podar International School\",\n    \"address\": \"Chandkheda, Ahmedabad, Gujarat\",\n    \"latitude\": 23.1081,\n    \"longitude\": 72.5971\n  }\n}"
				},
				{
					"name": "Validation Error",
					"status": "Bad Request",
					"code": 400,
					"body": "{\n  \"success\": false,\n  \"message\": \"Validation failed.\",\n  \"errors\": [\n    \"name is required and must be a non-empty string.\",\n    \"latitude must be between -90 and 90.\"\n  ]\n}"
				}
			]
		},
		{
			"name": "Add School - Puna International",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
